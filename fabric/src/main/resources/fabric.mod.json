{
	"schemaVersion": 1,
	"id": "carpetscore",
	"version": "${version}",
	"name": "carpetscore",
	"description": "Simple lib for creating multifaced blocks.",
	"authors": [
		"ludwici"
	],
	"contact": {
	},
	"license": "MIT",
	"icon": "assets/carpetscore/carpetscore.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.ludwici.carpetscore.CarpetsCore"
		],
		"client": [
			"com.ludwici.carpetscore.CarpetsCoreClient"
		]
	},
	"mixins": [
		"carpetscore.mixins.json",
		{
			"config": "carpetscore.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}